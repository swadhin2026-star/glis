# .env.example
# GLIS Live Data Integration Environment Variables

# NASA FIRMS API Key for live fire hotspots
# Get it from: https://firms.modaps.eosdis.nasa.gov/api/
NASA_FIRMS_MAP_KEY=""

# Data.gov.in API Key for population
# Get it from: https://api.data.gov.in
DATA_GOV_IN_API_KEY=""

# Data.gov.in Resource ID for the state population dataset
DATA_GOV_IN_POPULATION_RESOURCE_ID=""

# Bhuvan API Key for LULC (Requires NRSC Registration)
BHUVAN_API_KEY=""

# Note for Windows PowerShell:
# To set these before running the server, use:
# $env:NASA_FIRMS_MAP_KEY="your_key_here"
# $env:DATA_GOV_IN_API_KEY="your_key_here"
